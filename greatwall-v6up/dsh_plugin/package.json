{
  "name": "dsh-greatwall-v6up",
  "version": "0.3.2",
  "description": "GreatWall Agent v0.3.2：面向长周期自主科学发现的 DSH 0.2.2-rc.5 人机协同总控 × 10 角色物理分权 × Outbox 副作用队列 × 宏观大外环波次圆桌 × Python Single-Writer 53 窄工具科研引擎。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "greatwall-v6up",
    "ai-for-science",
    "multi-agent",
    "mcp"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client_src",
    "tools",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node ./tools/build_client.mjs",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "doctor": "node ./tools/doctor.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
