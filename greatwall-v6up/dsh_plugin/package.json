{
  "name": "dsh-greatwall-v6up",
  "version": "3.0.0",
  "description": "长城 Agent V6-Up (v3.0)：面向通用长周期自主科学发现的 DSH 0.2.2-rc.3 极薄事件总线 × 双向隔离沙箱（探索 Worktree + 空白盲审沙箱）× Python Single-Writer 32 窄工具与三档四态仪器内核。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "greatwall-v6up",
    "ai-for-science",
    "multi-agent",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "presets",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
