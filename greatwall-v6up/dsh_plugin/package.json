{
  "name": "dsh-greatwall-v6up",
  "version": "2.2.0",
  "description": "长城 Agent V6-Up (v2.2)：基于 DSH 0.2.2-rc.3 原生 Runtime（ctx.agents.create / sessionProjections.contextPressure / tokenMeter.measure / sessionQuery 黑匣子 / concludeTurn 回合间隙控制流 / 方案 A 混合隔离）× Python Single-Writer 31 窄工具 MCP 编排总线。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "greatwall-v6up",
    "ai-for-science",
    "multi-agent",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
